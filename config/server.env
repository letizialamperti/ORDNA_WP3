# Copy to config/server.env. One fold per OAR job.
# RAW_DIR, Conda settings and sequence length recovered from the BT launcher.
# Output/cache paths below are NEW ORDNA destinations, not recovered BT outputs.
FOLD=01
RAW_DIR="/bettik/PROJECTS/pr-qiepb/lampertl/all"
OUTPUT_ROOT="/bettik/PROJECTS/pr-qiepb/lampertl/runs_ordna_strict5km_3fold/seed0"
CACHE_DIR="/bettik/PROJECTS/pr-qiepb/lampertl/ordna_token_cache"
CONDA_SH="/applis/environments/conda.sh"
CONDA_ENV="zioboia"
PYTHON_BIN="python"
DEVICE="cuda"
# Matches BT launcher sequence length. QC still rejects longer reads.
SEQUENCE_LENGTH=300
# Exploratory budget, not copied from BT or tuned: do a one-step batch1 pilot first.
STEPS_PER_EPOCH=200
EPOCHS=20
BATCH_SIZE=8
SUBSET_SIZE=1000
EMBEDDING_DIM=64
REPRESENTATION_DIM=256
SEED=0
EXPORT_SEED=0
# Empty exports all reads; e.g. 10 limits inference to 10 subsets per sample.
MAX_EXPORT_SUBSETS=""
